-        private String description;
-        private String fix;
-        private String fix_location;
-    }
-
-    private List<VulnerabilityInfo> parseVulnerabilities(String aiResponse) {
-        List<VulnerabilityInfo> vulnerabilities = new ArrayList<>();
-        String[] sections = aiResponse.split("---");
-        int vulnerabilityCount = 0;
-
-        for (String section : sections) {
-            if (section.trim().isEmpty()) continue;
-
-            vulnerabilityCount++;
-            Map<String, String> vulnMap = new HashMap<>();
-
-            // Extract each field
-            String[] lines = section.trim().split("\n");
-            for (String line : lines) {
-                String[] parts = line.split(":", 2);
-                if (parts.length == 2) {
-                    String key = parts[0].trim();
-                    String value = parts[1].trim();
-                    vulnMap.put(key, value);
-                }
-            }
-
-            // Create VulnerabilityInfo object
-            VulnerabilityInfo vulnInfo = new VulnerabilityInfo(
