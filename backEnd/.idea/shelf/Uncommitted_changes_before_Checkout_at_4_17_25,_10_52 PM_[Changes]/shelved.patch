-                        "\n---" +
-                        "\n\nRepeat this format for each vulnerability found. Here's the code to analyze:\n\n%s", code);
-
-        String aiResponse = chatClient.prompt()
-                .user(prompt)
-                .call()
-                .content();
-
-        List<VulnerabilityInfo> vulnerabilities = parseVulnerabilities(aiResponse);
-        return new ResponseEntity<>(Map.of("response", vulnerabilities), HttpStatus.OK);
-    }
-
-    // POJO to represent vulnerability information
-    @Data
-    @NoArgsConstructor
-    @AllArgsConstructor
-    static class VulnerabilityInfo {
-        private int vulnerability;
