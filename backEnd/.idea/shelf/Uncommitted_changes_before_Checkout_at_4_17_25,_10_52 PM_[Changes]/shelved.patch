<+>package dev.obie;\n\nimport org.springframework.ai.chat.client.ChatClient;\nimport org.springframework.core.ParameterizedTypeReference;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * @Author: Obieda Ananbeh\n * @Date 10/27/24\n */\n\n@RestController\n@RequestMapping(\"/v2\")\npublic class VulnerabilityController {\n    private final ChatClient chatClient;\n\n    public VulnerabilityController(ChatClient.Builder builder) {\n        String systemPrompt = \"You are a security expert focused on code analysis. Always analyze code systematically:\" +\n                \"\\n1. First identify clear security vulnerabilities like SQL injection, XSS, etc.\" +\n                \"\\n2. Then check for common implementation issues\" +\n                \"\\n3. Focus only on real security issues, not style or performance\" +\n                \"\\n4. Provide specific line numbers and exact code fixes\" +\n                \"\\n5. Use standard CWE IDs\" +\n                \"\\nBe consistent in your analysis.\";\n\n        this.chatClient = builder\n                .defaultSystem(systemPrompt)\n                .build();\n    }\n\n\n    @RequestMapping(\"/vul\")\n    public ResponseEntity<?> vul(@RequestBody Map<String, String> requestBody) {\n        try {\n            String code = requestBody.get(\"code\");\n            if (code == null || code.trim().isEmpty()) {\n                return ResponseEntity.badRequest().body(\"Code parameter is required\");\n            }\n\n            List<VulInfo> vulnerabilities = chatClient.prompt()\n                    .user(u -> u.text(\"\"\"\n                Analyze the following code for vulnerabilities and return the results in JSON format only. \n                If vulnerabilities are found, return an array of objects with these exact fields: \n                vulnerable_code, line_number, class_name, method_name, cwe_id, description, fix_vulnerable_code, fix_location.\n                If no vulnerabilities are found, return an empty array [].\n                Return only the JSON array with no additional text or explanation.\n                Code to analyze: {code}\n                \"\"\").param(\"code\", code))\n                    .call()\n                    .entity(new ParameterizedTypeReference<List<VulInfo>>() {});\n\n            if (vulnerabilities == null || vulnerabilities.isEmpty()) {\n                // Update the response with all fields in the VulInfo object\n                return ResponseEntity.ok(List.of(new VulInfo(\n                        \"Not provided\", \"Not provided\", \"Not provided\",\n                        \"Not provided\", \"No vulnerabilities found\", \"Not provided\",\n                        \"Not provided\", \"Not provided\")));\n            }\n\n            return ResponseEntity.ok(vulnerabilities);\n\n        } catch (Exception e) {\n            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)\n                    .body(\"Error processing request: \" + e.getMessage());\n        }\n    }\n    @RequestMapping(\"/vul2\")\n    public ResponseEntity<?> CEW(@RequestBody Map<String, String> requestBody) {\n\n        String code = requestBody.get(\"code\");\n\n            List<CEW> vulnerabilities = chatClient.prompt()\n                    .user(u -> u.text(\"\"\"\n                Analyze the following code for vulnerabilities and return the results in JSON format only. \n                only on real security issues, not style or performance\" , \n                only consider the following CWE ID [CWE-23 , CWE-918, CWE-319, CWE-134, CWE-502, CWE-113, CWE-501, CWE-470, CWE-601, CWE-78]\n                If vulnerabilities are found, return an array of objects with these exact fields: \n                cwe_id, exact_vulnerable_code, replace_it_with_secure_code.\n                If no vulnerabilities are found, return an empty array [].\n                Return only the JSON array with no additional text or explanation.\n                Code to analyze: {code}\n                \"\"\").param(\"code\", code))\n                    .call()\n                    .entity(new ParameterizedTypeReference<List<CEW>>() {});\n\n            if (vulnerabilities == null || vulnerabilities.isEmpty()) {\n                // Update the response with all fields in the VulInfo object\n                return ResponseEntity.ok(List.of(new CEW(\n                        \"Not provided\", \"Not provided\",\"Not provided\")));\n            }\n\n            return ResponseEntity.ok(vulnerabilities);\n\n    }\n\n}\n\n
